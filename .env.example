# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional AI Help target. The local sharing UI works without these values.
AGENT_ENGINE_RESOURCE_NAME=projects/your-gcp-project/locations/us-east1/reasoningEngines/your-engine-id
AGENT_DIRECTORY=app

# Optional Help access gate. Use independently generated random values for
# remote deployments and store them in Secret Manager, never in Git.
CHAT_PROXY_ACCESS_TOKEN=
CHAT_PROXY_SESSION_SECRET=
